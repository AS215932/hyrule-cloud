# Hyrule Cloud Configuration
# Copy to .env and fill in your values

# --- Xen Orchestra (all XCP-NG ops go through XO) ---
XCPNG_XO_URL=ws://[2a0c:b641:b50:2::70]/api/
XCPNG_XO_TOKEN=                  # Xen Orchestra -> Settings -> Tokens
XCPNG_XO_VERIFY_SSL=false
XCPNG_DEFAULT_SR_UUID=           # `xe sr-list` on your XCP-NG host
XCPNG_DEFAULT_NETWORK_UUID=      # `xe network-list` - your IPv6 network
XCPNG_VCPU_OVERCOMMIT_RATIO=2.0
XCPNG_MEMORY_HEADROOM_MB=2048
XCPNG_STORAGE_HEADROOM_GB=20

# Template UUIDs: get with `xe template-list`
# Format: JSON dict {"debian-13": "uuid-here", "openbsd-7.8": "uuid-here"}
XCPNG_TEMPLATES={"debian-13": "", "openbsd-7.8": ""}

# OpenBSD offline root resize builder. Required for OpenBSD customer VMs.
# The builder is a dedicated OpenBSD VM that stays halted except while preparing
# a newly cloned OpenBSD root VDI before first boot.
XCPNG_OPENBSD_BUILDER_VM_UUID=
XCPNG_OPENBSD_BUILDER_SSH_HOST=
XCPNG_OPENBSD_BUILDER_SSH_USER=svag
XCPNG_OPENBSD_BUILDER_SSH_KEY_PATH=/run/secrets/openbsd_builder_ssh_key
XCPNG_OPENBSD_BUILDER_DISK_DEVICE=sd1
XCPNG_OPENBSD_BUILDER_ATTACH_POSITION=1

# --- Openprovider ---
OPENPROVIDER_API_URL=https://api.openprovider.eu/v1beta
OPENPROVIDER_USERNAME=
OPENPROVIDER_PASSWORD=
OPENPROVIDER_OWNER_HANDLE=       # e.g. SR003891-NL
OPENPROVIDER_ADMIN_HANDLE=
OPENPROVIDER_TECH_HANDLE=
OPENPROVIDER_BILLING_HANDLE=
OPENPROVIDER_NAMESERVERS=["ns1.hyrule.host","ns2.hyrule.host"]

# --- Managed Domains ---
# Discovery remains available when purchases are disabled. Production sales
# fail closed until all three approval switches are true.
DOMAIN_ENABLED=true
DOMAIN_PURCHASES_ENABLED=false
DOMAIN_LEGAL_APPROVED=false
DOMAIN_TAX_APPROVED=false
DOMAIN_TERMS_VERSION=2026-07-15
DOMAIN_QUOTE_TTL_SECONDS=900
DOMAIN_CATALOG_SYNC_SECONDS=21600
DOMAIN_CATALOG_MAX_AGE_SECONDS=86400
DOMAIN_RENEWAL_WINDOW_DAYS=60
DOMAIN_RENEWAL_DUE_DAYS=30
DOMAIN_JOB_LOCK_TIMEOUT_SECONDS=900
DOMAIN_PROVIDER_RECONCILE_DELAY_SECONDS=60
DOMAIN_MARKUP_PERCENT=0.25
DOMAIN_MARKUP_MIN_USD=3.00
DOMAIN_TLD_ALLOWLIST=[]
DOMAIN_ACCOUNT_ALLOWLIST=[]
DOMAIN_MANAGED_NAMESERVERS=["ns1.hyrule.host","ns2.hyrule.host"]
DOMAIN_SOA_MNAME=ns1.hyrule.host
DOMAIN_SOA_RNAME=hostmaster.hyrule.host
DOMAIN_DNS_CONTROL_URL=http://[2a0c:b641:b50:2::10]:8453
DOMAIN_DNS_CONTROL_SECRET=
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
DOMAIN_AUTHCODE_FERNET_KEY=
DOMAIN_OPENPROVIDER_WEBHOOK_SECRET=

# --- DNS blocklist catalog and live filtering matrix ---
# The worker downloads and atomically compiles the catalog. API processes mount
# this same directory read-only. Resolver checks use only the fixed public DoH
# profiles returned by GET /v1/dns/filtering/resolvers.
DNS_BLOCKLIST_ENABLED=true
DNS_BLOCKLIST_DATA_DIR=/var/lib/hyrule-cloud/blocklists
DNS_BLOCKLIST_REFRESH_SECONDS=21600
DNS_BLOCKLIST_STALE_AFTER_SECONDS=172800
DNS_BLOCKLIST_MAX_AGE_SECONDS=604800
DNS_BLOCKLIST_MINIMUM_COVERAGE=0.75
DNS_FILTERING_ENABLED=true
DNS_FILTERING_QUERY_TIMEOUT_SECONDS=3
DNS_FILTERING_OVERALL_TIMEOUT_SECONDS=6
DNS_FILTERING_CACHE_TTL_SECONDS=60
DNS_FILTERING_MINIMUM_CONCLUSIVE_PROFILES=6

# --- x402 Payments ---
PAYMENT_RECEIVER_ADDRESS=        # Your wallet address (receives USDC)
PAYMENT_FACILITATOR_URL=https://facilitator.payai.network
PAYMENT_NETWORK=eip155:8453      # Base mainnet
PAYMENT_ASSET=USDC
CDP_API_KEY_ID=                  # Optional; required only for Coinbase CDP facilitator
CDP_API_KEY_SECRET=              # Optional PEM private key; use a secret manager in production

# Pricing (USD per day)
PAYMENT_PRICE_VM_XS=0.20
PAYMENT_PRICE_VM_SM=0.40
PAYMENT_PRICE_VM_MD=0.60
PAYMENT_PRICE_VM_LG=0.80
PAYMENT_PRICE_VM_ADDON_VCPU=0.10
PAYMENT_PRICE_VM_ADDON_RAM_GB=0.15
PAYMENT_PRICE_VM_ADDON_DISK_10GB=0.05
PAYMENT_PRICE_DOMAIN_MARKUP=1.00
PAYMENT_PRICE_PROXY_DIRECT=0.01
PAYMENT_PRICE_PROXY_TOR=0.05
PAYMENT_PRICE_PROXY_I2P=0.05
PAYMENT_PRICE_PROXY_YGGDRASIL=0.03
PAYMENT_PRICE_BGP_LOOKUP=0.005
PAYMENT_PRICE_BGP_ROUTER_QUERY=0.01
PAYMENT_PRICE_BGPSTREAM_HOUR=0.05
PAYMENT_PRICE_BGPSTREAM_RIB=0.10
PAYMENT_PRICE_BGP_ROUTER_TABLE=0.10
PAYMENT_PRICE_IP_LOOKUP=0.003
PAYMENT_PRICE_DNS_LOOKUP=0.001
PAYMENT_PRICE_DNS_BLOCKLIST_CHECK=0.003
PAYMENT_PRICE_DNS_FILTERING_CHECK=0.01
PAYMENT_PRICE_RDAP_LOOKUP=0.003
PAYMENT_PRICE_WHOIS_LOOKUP=0.005
PAYMENT_PRICE_MX_CHECK=0.005
PAYMENT_PRICE_MX_REPORT=0.03
PAYMENT_PRICE_WEB_CHECK=0.005
PAYMENT_PRICE_WEB_TLS_DEEP=0.10
PAYMENT_PRICE_PATH_PROBE=0.005
PAYMENT_PRICE_PATH_REPORT=0.05
PAYMENT_PRICE_PORT_CHECK=0.003
PAYMENT_PRICE_NAT_PORT_FORWARD_CHECK=0.005
PAYMENT_PRICE_THREAT_LOOKUP=0.01
PAYMENT_PRICE_VOIP_CHECK=0.01
PAYMENT_PRICE_VOIP_NUMBER_LOOKUP=0.05

# --- Hyrule General ---
HYRULE_DEPLOY_DOMAIN=deploy.hyrule.host

# --- Customer VM networking (IPv6-only + NAT64) ---
# Each VM gets a /64 out of the supernet and a static netplan config; the
# gateway must be on-link inside the supernet.
HYRULE_CUSTOMER_IPV6_SUPERNET=2a0c:b641:b51::/48
HYRULE_CUSTOMER_IPV6_GATEWAY=2a0c:b641:b51::1
# Comma-separated resolvers written verbatim into every customer VM's netplan.
# This MUST be an address where a resolver is actually LISTENING on port 53 and
# reachable from the customer /64, and it MUST be DNS64-capable: the VMs are
# IPv6-only behind NAT64, so IPv4-only destinations (most package mirrors,
# most of the internet) are only reachable if the resolver synthesises AAAA
# records into the NAT64 prefix (64:ff9b::/96).
#
# It is NOT enough for the address to route traffic. Setting this to the
# gateway because "the router is right there" shipped every VM unable to
# resolve any hostname (2026-07-24): the gateway forwarded packets perfectly
# and refused TCP/UDP 53. Startup logs a `customer_dns_equals_gateway` warning
# for exactly that shape; verify from a VM with:
#   dig @<resolver> deb.debian.org AAAA
HYRULE_CUSTOMER_IPV6_DNS=2a0c:b641:b50:2::1
# Hostname the launch proof asks that resolver to resolve before a VM is
# reported provisioned. Leave blank to skip the probe (reports not_run).
HYRULE_CUSTOMER_DNS_PROBE_HOSTNAME=deb.debian.org

# Browser-session-only administrator payment waivers (off by default).
HYRULE_ADMIN_PAYMENT_BYPASS_ENABLED=false
HYRULE_ADMIN_STEP_UP_SECONDS=600
HYRULE_ADMIN_DIAGNOSTIC_BYPASS_PER_MINUTE=120
HYRULE_ADMIN_COST_BYPASS_PER_HOUR=10

# Internal Go sidecar for x402-gated network requests.
HYRULE_NETWORK_PROXY_URL=http://127.0.0.1:8450
HYRULE_NETWORK_PROXY_TOKEN=
HYRULE_NETWORK_PROXY_HEALTH_TTL_SECONDS=15

# Internal prober sidecar (hyrule-prober) for x402-gated /v1/path/* probes. In
# production HYRULE_PROBER_URL points at noc's internal address. Leaving the
# token empty keeps path/ping + path/report gated (501, hidden from the
# manifest). The prober MUST expose vantages named "as215932" and "extmon" to
# match the DiagnosticVantage values Hyrule Cloud requests.
HYRULE_PROBER_URL=http://127.0.0.1:8460
HYRULE_PROBER_TOKEN=
HYRULE_PROBER_HEALTH_TTL_SECONDS=30

# Reverse-SSH tunnel daemon (hyrule-tunnel-proxy). The tunnel catalog entry
# stays hidden until HYRULE_TUNNEL_PROXY_TOKEN is set (the readiness gate).
HYRULE_TUNNEL_PROXY_URL=http://127.0.0.1:8452
HYRULE_TUNNEL_PROXY_TOKEN=
HYRULE_TUNNEL_PROXY_HEALTH_TTL_SECONDS=15
HYRULE_TUNNEL_MIN_HOURS=1
HYRULE_TUNNEL_MAX_HOURS=720
HYRULE_TUNNEL_GRACE_PERIOD_MINUTES=15
HYRULE_TUNNEL_PROVISIONAL_TTL_MINUTES=15
# Public STUN responder for the /v1/voip/check STUN arm (empty = stubbed).
HYRULE_STUN_TEST_HOST=
PAYMENT_PRICE_TUNNEL_HOURLY=0.05
HYRULE_BGP_DATA_ENABLED=true
HYRULE_BGP_DATA_DIR=/var/lib/hyrule-cloud/bgp
HYRULE_BGP_INGEST_TOKEN=
# Enable only after the collector transfers snapshot artifacts onto API-local
# storage (metadata-only ingest is not sufficient for paid downloads).
HYRULE_BGP_ROUTER_SNAPSHOT_DOWNLOAD_ENABLED=0

# Deploy-subdomain DNS (RFC 2136 dynamic updates). Customer-owned zones use
# the HMAC-authenticated DOMAIN_DNS_CONTROL_URL above.
HYRULE_DNS_SERVER=              # Your authoritative NS IP
HYRULE_DNS_TSIG_KEY=            # Base64 TSIG key
HYRULE_DNS_TSIG_ALGO=hmac-sha256

# VM Lifecycle
HYRULE_VM_GRACE_PERIOD_HOURS=48
HYRULE_MAX_DURATION_DAYS=365
HYRULE_MAX_PORTS=10
HYRULE_BLOCKED_PORTS=[25,465,587]

# Database (Postgres)
HYRULE_DATABASE_URL=postgresql+asyncpg://hyrule:hyrule@localhost/hyrule

# --- Block A1 / B (Wave 2): auth + metrics ---

# 16+ byte hex used to derive the per-IP prefix hash for rate-limit
# buckets. If blank, sessions still work but per-IP pepper is
# process-local and rotates on every restart. Vault populates in
# production; set with `openssl rand -hex 16`.
HYRULE_IP_PREFIX_PEPPER=

# Feature flags — Wave 2 ships migration 004 (intent engine) as DEAD
# SCHEMA so the linear alembic chain stays intact, but the consumer
# code stays disabled until the relevant wave ships:
#   HYR_FEATURES_API_KEYS         — flipped on by Wave 3 (Block D)
#   HYR_FEATURES_INTENT_ENGINE    — flipped on by Wave 4 (Block E)
#   HYR_FEATURES_WALLET_RECOVERY  — flipped on by Wave 5 (Block F)
HYRULE_FEATURES_API_KEYS=false
HYRULE_FEATURES_INTENT_ENGINE=false
HYRULE_FEATURES_WALLET_RECOVERY=false
